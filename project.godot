; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Purgatory Dungeon"
config/version="8"
run/main_scene="res://scenes/StudioSplash.tscn"
boot_splash/bg_color=Color(0.035, 0.03, 0.03, 1)
boot_splash/show_image=false
config/use_hidden_project_data_directory=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://app_icon/PurgatoryDungeon.png"
config/macos_native_icon="res://app_icon/PurgatoryDungeon.icns"
config/windows_native_icon="res://app_icon/PurgatoryDungeon.ico"

[autoload]

Boot="*res://scripts/boot/boot.gd"
UiTheme="*res://scripts/ui/ui_theme.gd"
GlobalRunData="*res://scripts/global_run_data.gd"
SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
PlayerWallet="*res://autoloads/PlayerWallet.gd"
GameClock="*res://autoloads/GameClock.gd"
BuffManager="*res://autoloads/BuffManager.gd"
GlobeManager="*res://autoloads/GlobeManager.gd"
SettingsManager="*res://scripts/SettingsManager.gd"
CodexManager="*res://scripts/codex_manager.gd"
InputManager="*res://scripts/InputManager.gd"

[display]

window/size/mode=3
window/size/viewport_width.android=1280
window/size/viewport_height.android=720
window/stretch/mode.android="canvas_items"
window/stretch/aspect.android="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false

